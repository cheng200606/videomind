# 复制为 .env（已被 .gitignore 拦截，禁止提交真实 Key）
# CONTRIBUTING.md 红线 2：不提交任何密钥、Token、.env

# 可选覆盖：不配置（保持注释）时默认为本地 SQLite（sqlite:///./data/videomind.db）与空 REDIS_URL。
# 只有本机真的起了 MySQL/Redis 才取消注释——两者都没起会导致应用启动失败
# DATABASE_URL=mysql+pymysql://videomind:videomind@localhost:3306/videomind?charset=utf8mb4
# REDIS_URL=redis://localhost:6379/0

# DeepSeek —— 走 OpenAI 兼容协议，用 httpx 直连（不依赖 openai SDK）；base_url/model 可在设置页自定义
DEEPSEEK_API_KEY=sk-xxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 三个策略开关（对应页 11 设置页：OCR 引擎切换 / ASR 词表校正 / 默认产物集）
# auto = 优先 whisper/yueying 等真实引擎，未安装重依赖时才退回 mock 演示（mock 不读取真实视频）
ASR_ENGINE=auto            # auto | whisper | yueying | funasr | mock
OCR_ENGINE=none            # rapid | paddle | vision | none
OUTPUT_SCHEMAS=summary,uml_draft,key_points,code_blocks
ASR_VOCABULARY_CROSSCHECK=false   # F5，课程版只做设计，不置 true

# 本地 Whisper（faster-whisper）默认参数；tiny 首次下载约 75MB，精度要求高可改 base/small（需能正常加载）
VMIND_WHISPER_MODEL=tiny
VMIND_WHISPER_DEVICE=cpu       # 有完整 CUDA 运行库时可改 auto/cuda

MEDIA_ROOT=./data/media
CACHE_ROOT=./data/cache

CORS_ORIGINS=http://localhost:5173
