          <mxCell id="uc01" value="批量导入本地视频&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#64748b&quot;&gt;多文件 · 一批次 N 条&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#4338ca;fontSize=13;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="375" y="202" width="210" height="66" as="geometry"/></mxCell>
