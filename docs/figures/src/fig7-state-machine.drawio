<mxCell id="e14" value="个别块失败" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.1;fontSize=8.5;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="555" y="717" as="sourcePoint"/><mxPoint x="700" y="717" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="e15" value="异常中断" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.1;fontSize=8.5;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="555" y="717" as="sourcePoint"/><mxPoint x="700" y="795" as="targetPoint"/><Array as="points"><mxPoint x="555" y="795"/></Array></mxGeometry></mxCell>
<mxCell id="e16" value="降级：直接跳过，不置 RUNNING" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8b5cf6;strokeWidth=1.1;dashed=1;dashPattern=5.5 3.5;fontSize=8.5;fontColor=#8b5cf6;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="210" y="744" as="sourcePoint"/><mxPoint x="375" y="815" as="targetPoint"/><Array as="points"><mxPoint x="210" y="815"/></Array></mxGeometry></mxCell>
<mxCell id="e17" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="117" y="970" as="sourcePoint"/><mxPoint x="150" y="970" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="e18" value="提交待确认" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.1;fontSize=8.5;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="970" as="sourcePoint"/><mxPoint x="420" y="970" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="e19" value="确认" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.1;fontSize=8.5;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="970" as="sourcePoint"/><mxPoint x="710" y="970" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="e20" value="修订" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.1;fontSize=8.5;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="890" y="970" as="sourcePoint"/><mxPoint x="980" y="970" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="e21" value="再次提交" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.1;fontSize=8.5;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1070" y="1000" as="sourcePoint"/><mxPoint x="520" y="1000" as="targetPoint"/><Array as="points"><mxPoint x="1070" y="1052"/><mxPoint x="520" y="1052"/></Array></mxGeometry></mxCell>
<mxCell id="e22" value="驳回" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.1;fontSize=8.5;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520" y="940" as="sourcePoint"/><mxPoint x="265" y="940" as="targetPoint"/><Array as="points"><mxPoint x="520" y="922"/><mxPoint x="265" y="922"/></Array></mxGeometry></mxCell>
<mxCell id="e23" value="回退重写" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=1.1;fontSize=8.5;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="800" y="940" as="sourcePoint"/><mxPoint x="200" y="940" as="targetPoint"/><Array as="points"><mxPoint x="800" y="900"/><mxPoint x="200" y="900"/></Array></mxGeometry></mxCell>
<mxCell id="cap0" value="注①：三层状态机画在同一画布，是因为它们串在同一条业务链上（视频解析 → 条目落库 → 讲义修订），但三者互相独立，不共享状态变量。" style="text;html=1;align=left;verticalAlign=top;fontSize=8.6;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="34" y="1131.0" width="1452" height="15" as="geometry"/></mxCell>
<mxCell id="cap1" value="注②：依据代码——视频 VideoStatus 5 个具名状态、阶段 StageStatus 6 个（含 SKIPPED）、讲义 RevisionState 4 个（转移表 REVISION_TRANSITIONS 在 enums.py 中显式声明）。" style="text;html=1;align=left;verticalAlign=top;fontSize=8.6;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="34" y="1146.5" width="1452" height="15" as="geometry"/></mxCell>
<mxCell id="cap2" value="注③：任务卡记「7 状态含重试」为粗口径；本图按 enums.py 逐字实现，共 15 个具名状态，一个不合并，以便与代码逐条对照、答辩可现场指认。" style="text;html=1;align=left;verticalAlign=top;fontSize=8.6;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="34" y="1162.0" width="1452" height="15" as="geometry"/></mxCell>
<mxCell id="cap3" value="注④：重试不是状态内自环。/videos/{id}/retry 先把四个阶段统一重置为 PENDING 再重跑，等同重新开始一次解析，故箭头重入 RUNNING，而不是把 PARTIAL 直接改成 SUCCEEDED。" style="text;html=1;align=left;verticalAlign=top;fontSize=8.6;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="34" y="1177.5" width="1452" height="15" as="geometry"/></mxCell>
<mxCell id="cap4" value="注⑤：进程重启兜底 recover_orphan_runs：遗留的 PENDING / RUNNING 视频一律置 FAILED，并写入「服务重启导致解析中断，可重试」，保证可重试、可删除，不会永久卡在 RUNNING。" style="text;html=1;align=left;verticalAlign=top;fontSize=8.6;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="34" y="1193.0" width="1452" height="15" as="geometry"/></mxCell>
<mxCell id="cap5" value="注⑥：批次 VideoBatch 状态不另画。它由 _recompute_batch_status 按成员视频终态聚合（全 SUCCEEDED → SUCCEEDED；含任一 SUCCEEDED / PARTIAL → PARTIAL；否则 FAILED），是派生值，不接受外部直接置位。" style="text;html=1;align=left;verticalAlign=top;fontSize=8.6;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="34" y="1208.5" width="1452" height="15" as="geometry"/></mxCell>
<mxCell id="cap6" value="注⑦：讲义流转两条硬约束——不在 REVISION_TRANSITIONS 中的跳转一律 422（如 DRAFT → CONFIRMED）；每次流转追加一条 Revision 快照，历史不覆盖，只有 CONFIRMED / REVISED 计入导出。" style="text;html=1;align=left;verticalAlign=top;fontSize=8.6;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="34" y="1224.0" width="1452" height="15" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
