<mxCell id="r3" value="&lt;b&gt;CONFIRMED&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#475569&quot;&gt;计入导出&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e9f6ee;strokeColor=#5f9e78;strokeWidth=1.3;fontSize=11.5;fontColor=#0f172a;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="710" y="940" width="180" height="60" as="geometry"/></mxCell>
<mxCell id="r4" value="&lt;b&gt;REVISED&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8.5px;color:#475569&quot;&gt;已修订，可再提交&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f4effe;strokeColor=#8b5cf6;strokeWidth=1.3;fontSize=11.5;fontColor=#0f172a;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="980" y="940" width="180" height="60" as="geometry"/></mxCell>
<mxCell id="n0" value="每个视频固定 4 行阶段状态：&lt;br&gt;transcribe / visual / structure / artifact&lt;br&gt;&lt;br&gt;· SKIPPED 不计入不完整判定&lt;br&gt;  （bad = FAILED, PARTIAL）；画面通道&lt;br&gt;  关闭或无关键帧时，视频仍可 SUCCEEDED&lt;br&gt;· 阶段 FAILED 不必然使视频 FAILED：&lt;br&gt;  仅 transcribe / structure / artifact 终止整条&lt;br&gt;· 重试时四阶段统一重置为 PENDING" style="text;html=1;align=left;verticalAlign=top;fontSize=8.6;fontColor=#475569;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="900" y="659.4" width="340" height="130.5" as="geometry"/></mxCell>
