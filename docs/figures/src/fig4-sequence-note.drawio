          <mxCell id="cap0" value="图 4  顺序图 B：大纲跳转与笔记写入" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontStyle=1;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="24" y="605" width="850" height="14" as="geometry"/></mxCell>
          <mxCell id="cap1" value="注：① 章节数据随条目一次取回（summary 产物的 payload.chapters），大纲点击与产物面板点击共用同一 seek 入口；② 跳转只赋值 video.currentTime，无网络往返；" style="text;html=1;align=left;verticalAlign=middle;fontSize=9;fontColor=#64748b;" vertex="1" parent="1"><mxGeometry x="24" y="620" width="850" height="14" as="geometry"/></mxCell>
          <mxCell id="cap2" value="③ 笔记默认继承条目 anchor_ms，经条目时间码可反向跳回原片；讲义正文修改另走 POST /items/{id}/revision，追加版本快照并校验状态机。" style="text;html=1;align=left;verticalAlign=middle;fontSize=9;fontColor=#64748b;" vertex="1" parent="1"><mxGeometry x="24" y="635" width="850" height="14" as="geometry"/></mxCell>
